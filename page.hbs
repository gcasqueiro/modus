{{!< default}}

{{#post}}
{{#contentFor "body_class"}}{{#if @page.show_title_and_feature_image}}{{#if feature_image}} has-top-image{{/if}}{{/if}}{{/contentFor}}
<article class="gc-page {{post_class}}">

    {{#if @page.show_title_and_feature_image}}
        {{#if feature_image}}
        <figure class="gc-page-hero" data-parallax>
            <img class="gc-page-hero__img"
                src="{{img_url feature_image size="xl"}}"
                alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}">
        </figure>
        {{/if}}
    {{/if}}

    <div class="gc-page-block">
        {{#if @page.show_title_and_feature_image}}
        <header class="gc-page-header gc-content-column">
            <h1 class="gc-page-header__title">{{title}}</h1>
        </header>
        {{/if}}

        <div class="gc-content-column">
            <section class="gc-content gh-content">
                {{content}}
            </section>
        </div>
    </div>

</article>
{{/post}}

{{ghost_head}}

{{!-- Light/dark accents after ghost_head so Brand UI (buttons, portal) matches theme settings. --}}
<style>
    :root {
        --gc-accent-light: {{@custom.light_accent_color}};
        --gc-accent-dark: {{@custom.dark_accent_color}};
    }

    :root,
    [data-theme="light"] {
        --gc-accent: var(--gc-accent-light);
        --gc-accent-hover: color-mix(in srgb, var(--gc-accent) 82%, #000);
        --ghost-accent-color: var(--gc-accent-light);
    }

    [data-theme="dark"] {
        --gc-accent: var(--gc-accent-dark);
        --gc-accent-hover: color-mix(in srgb, var(--gc-accent) 82%, #fff);
        --ghost-accent-color: var(--gc-accent-dark);
    }
</style>

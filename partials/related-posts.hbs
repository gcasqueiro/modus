{{!--
    Related posts at the bottom of a post.
    1) Posts that share any tag with this one
    2) Otherwise: other recent posts
    Always excludes the current post.
--}}
{{#post}}

{{#get "posts" filter="tags:[{{tags}}]+id:-{{id}}" limit="3" include="tags" as |related|}}
    {{#foreach related}}
        {{#if @first}}
        <section class="gc-related" aria-labelledby="gc-related-title">
            <div class="gc-container">
                <h2 class="gc-related__title" id="gc-related-title">You might also like...</h2>
                <div class="gc-related__grid">
        {{/if}}
                    {{> "related-card"}}
        {{#if @last}}
                </div>
            </div>
        </section>
        {{/if}}
    {{else}}
        {{#get "posts" filter="id:-{{../id}}" limit="3" include="tags" as |more|}}
            {{#foreach more}}
                {{#if @first}}
                <section class="gc-related" aria-labelledby="gc-related-title">
                    <div class="gc-container">
                        <h2 class="gc-related__title" id="gc-related-title">You might also like...</h2>
                        <div class="gc-related__grid">
                {{/if}}
                            {{> "related-card"}}
                {{#if @last}}
                        </div>
                    </div>
                </section>
                {{/if}}
            {{/foreach}}
        {{/get}}
    {{/foreach}}
{{/get}}

{{/post}}

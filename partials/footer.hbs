<footer class="gc-footer" role="contentinfo">
    <div class="gc-container">

        <div class="gc-footer__socials">
            {{> "socials-helper"}}
        </div>

        <div class="gc-footer__inner">
            <p class="gc-footer__copy">
                {{#if @custom.footer_text}}{{@custom.footer_text}}{{else}}&copy; {{date format="YYYY"}} {{@site.title}}{{/if}}
            </p>
            <p class="gc-footer__meta">
                Powered by <a href="https://ghost.org" target="_blank" rel="noopener noreferrer">Ghost</a>
            </p>
        </div>

    </div>
</footer>

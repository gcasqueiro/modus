{{!< default}}

{{#post}}
{{#contentFor "body_class"}}{{#if feature_image}} has-top-image{{/if}}{{/contentFor}}
<article class="gc-post {{post_class}}">

    {{#if feature_image}}
    <figure class="gc-post-feature" data-parallax>
        <img class="gc-post-feature__img"
            src="{{img_url feature_image size="xl"}}"
            alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}">
    </figure>
    {{/if}}

    <header class="gc-post-header gc-content-column{{#if feature_image}} gc-post-header--below{{/if}}">
        {{#if tags}}
        <div class="gc-post-header__tags">
            {{#foreach tags}}
            <a class="gc-tag-pill" href="{{url}}">{{name}}</a>
            {{/foreach}}
        </div>
        {{/if}}
        <h1 class="gc-post-header__title">{{title}}</h1>
        <div class="gc-post-byline">
            {{#primary_author}}
            {{#if profile_image}}
            <img class="gc-post-byline__avatar" src="{{img_url profile_image size="xs"}}" alt="{{name}}" loading="lazy">
            {{/if}}
            {{/primary_author}}
            <div class="gc-post-byline__text">
                {{#primary_author}}
                <a class="gc-post-byline__author" href="{{url}}">{{name}}</a>
                {{/primary_author}}
                <div class="gc-post-header__meta">
                    <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="MMM D, YYYY"}}</time>
                    {{#match @custom.show_reading_time true}}
                    <span class="gc-dot" aria-hidden="true">&middot;</span>
                    <span>{{reading_time}}</span>
                    {{/match}}
                </div>
            </div>
        </div>
    </header>

    <div class="gc-content-column">
        <section class="gc-content gh-content">
            {{content}}
        </section>

        <footer class="gc-post-footer">
            {{#if tags}}
            <div class="gc-post-tags">
                {{#foreach tags}}
                <a class="gc-tag-pill" href="{{url}}">{{name}}</a>
                {{/foreach}}
            </div>
            {{/if}}

            {{#primary_author}}
            <div class="gc-author-card">
                {{#if profile_image}}
                <img class="gc-author-card__avatar" src="{{img_url profile_image size="s"}}" alt="{{name}}" loading="lazy">
                {{/if}}
                <div class="gc-author-card__body">
                    <a class="gc-author-card__name" href="{{url}}">{{name}}</a>
                    {{#if bio}}<p class="gc-author-card__bio">{{bio}}</p>{{/if}}
                </div>
            </div>
            {{/primary_author}}
        </footer>
    </div>

</article>

{{!--
    Related posts — kept inside {{#post}} so {{id}} and {{tags}} resolve correctly.
    Prefer shared tags; if that returns nothing, show other recent posts.
--}}
{{#if primary_tag}}
    {{#get "posts" filter="tag:{{primary_tag.slug}}+id:-{{id}}" limit="3" include="tags"}}
        {{#foreach posts}}
            {{#if @first}}
            <section class="gc-related" aria-labelledby="gc-related-title">
                <div class="gc-container">
                    <h2 class="gc-related__title" id="gc-related-title">You might also like...</h2>
                    <div class="gc-related__grid">
            {{/if}}
                        {{> "related-card"}}
            {{#if @last}}
                    </div>
                </div>
            </section>
            {{/if}}
        {{else}}
            {{#get "posts" filter="id:-{{../id}}" limit="3" include="tags"}}
                {{#foreach posts}}
                    {{#if @first}}
                    <section class="gc-related" aria-labelledby="gc-related-title">
                        <div class="gc-container">
                            <h2 class="gc-related__title" id="gc-related-title">You might also like...</h2>
                            <div class="gc-related__grid">
                    {{/if}}
                                {{> "related-card"}}
                    {{#if @last}}
                            </div>
                        </div>
                    </section>
                    {{/if}}
                {{/foreach}}
            {{/get}}
        {{/foreach}}
    {{/get}}
{{else}}
    {{#get "posts" filter="id:-{{id}}" limit="3" include="tags"}}
        {{#foreach posts}}
            {{#if @first}}
            <section class="gc-related" aria-labelledby="gc-related-title">
                <div class="gc-container">
                    <h2 class="gc-related__title" id="gc-related-title">You might also like...</h2>
                    <div class="gc-related__grid">
            {{/if}}
                        {{> "related-card"}}
            {{#if @last}}
                    </div>
                </div>
            </section>
            {{/if}}
        {{/foreach}}
    {{/get}}
{{/if}}

{{#if @site.members_enabled}}
{{#unless @member}}
<aside class="gc-subscribe-cta gc-content-column">
    <h2 class="gc-subscribe-cta__title">{{#if @custom.subscribe_heading}}{{@custom.subscribe_heading}}{{else}}Follow the journey{{/if}}</h2>
    <p class="gc-subscribe-cta__text">{{#if @custom.subscribe_subtitle}}{{@custom.subscribe_subtitle}}{{else}}New dev logs and experiments, straight to your inbox or RSS reader. No spam, no tracking.{{/if}}</p>
    <form class="gc-subscribe-form" data-members-form="signup">
        <input class="gc-subscribe-form__input" data-members-email type="email" required placeholder="you@example.com" autocomplete="email" aria-label="Your email address">
        <button class="gc-subscribe-form__button" type="submit">Subscribe</button>
    </form>
    <p class="gc-subscribe-form__message" data-members-error></p>
</aside>
{{/unless}}
{{/if}}

{{!-- Ghost native comments: only render when enabled in Admin and the visitor can access the post. --}}
{{#if comments}}
<section class="gc-comments gc-content-column" aria-label="Member discussion">
    {{comments title="Member discussion" count=true mode="auto"}}
    {{!-- Pin color-scheme to the page theme before comments-ui reads the script tag. --}}
    <script>
        (function () {
            var theme = document.documentElement.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
            var section = document.currentScript && document.currentScript.parentElement;
            if (!section) return;
            var tags = section.querySelectorAll('script[data-color-scheme], script[data-ghost-comments]');
            for (var i = 0; i < tags.length; i++) {
                tags[i].setAttribute('data-color-scheme', theme);
            }
        })();
    </script>
</section>
{{/if}}

{{/post}}
